# Copier ce fichier en .env et l'adapter. Le .env n'est JAMAIS versionné (voir .gitignore).

# --- Développement local ---------------------------------------------------
# DJANGO_DEBUG=1
# (rien d'autre n'est nécessaire en local)

# --- Production --------------------------------------------------------------
DJANGO_DEBUG=0
# Générer une clé avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_ALLOWED_HOSTS=costalats-backyard.emeryk-ablonet.fr

# Photos : envoi des fichiers délégué à nginx (location /_protege/). Toujours 1 en production.
DJANGO_PHOTOS_X_ACCEL=1
# Espace maximum pour les photos, en Go
DJANGO_PHOTOS_QUOTA_GO=10

# Facultatif : emplacements hors du dossier du code
# DJANGO_DB_PATH=/srv/backyard/data/db.sqlite3
# DJANGO_STATIC_ROOT=/srv/backyard/staticfiles
# DJANGO_MEDIA_ROOT=/srv/backyard/media   (penser à changer aussi l'alias /_protege/ dans nginx)
